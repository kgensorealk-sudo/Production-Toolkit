{
  "name": "production-toolkit",
  "version": "1.8.0",
  "type": "module",
  "description": "Professional Editorial Workflow Suite with Security Hardening",
  "main": "electron/main.js",
  "author": "Editorial Systems Pro",
  "license": "MIT",
  "scripts": {
    "dev": "tsx server.ts",
    "lint": "tsc --noEmit",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder build --windows --dir",
    "electron:dist": "npm run build && electron-builder build --windows"
  },
  "dependencies": {
    "@google/genai": "^1.43.0",
    "@supabase/supabase-js": "^2.39.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react-window": "^1.8.8",
    "autoprefixer": "^10.4.20",
    "date-fns": "^4.1.0",
    "diff": "^5.2.0",
    "emoji-picker-react": "^4.18.0",
    "express": "^5.2.1",
    "lucide-react": "^0.574.0",
    "motion": "^12.34.2",
    "postcss": "^8.4.49",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.12.0",
    "react-window": "^1.8.10",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/diff": "^5.0.9",
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.prodtoolkit.pro",
    "productName": "Production Toolkit Pro",
    "copyright": "© 2026 Editorial Systems Pro. All rights reserved.",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "favicon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "favicon.png",
      "requestedExecutionLevel": "asInvoker",
      "publisherName": "Editorial Systems Team",
      "artifactName": "${productName}-v${version}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerHeaderIcon": "favicon.png"
    }
  }
}
